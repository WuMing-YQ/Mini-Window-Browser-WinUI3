<Page x:Class="MiniWindow.PresetPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="24" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="场景预设" Style="{StaticResource TitleTextBlockStyle}"/><ListView x:Name="Items" Grid.Row="1" AutomationProperties.Name="场景列表"/><Button x:Name="NewButton" Grid.Row="2" Content="保存当前场景…"/></Grid><ScrollViewer Grid.Column="1"><StackPanel Spacing="16"><TextBlock Text="场景详情" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBox x:Name="PresetName" Header="名称" AutomationProperties.Name="场景名称"/><TextBlock x:Name="Summary" TextWrapping="Wrap"/><TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SaveButton" Content="保存场景"/><Button x:Name="ApplyButton" Content="应用场景" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="DeleteButton" Content="删除场景"/></StackPanel><TextBlock Text="应用将替换当前标签和窗口设置；书签、主题和渲染模式保持全局。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></ScrollViewer></Grid></Page>