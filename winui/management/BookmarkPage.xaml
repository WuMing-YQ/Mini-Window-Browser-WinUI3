<Page x:Class="MiniWindow.BookmarkPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="24" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="书签" Style="{StaticResource TitleTextBlockStyle}"/><ListView x:Name="Items" Grid.Row="1" AutomationProperties.Name="书签列表"/><Button x:Name="NewButton" Grid.Row="2" Content="新增书签"/></Grid>
<ScrollViewer Grid.Column="1"><StackPanel Spacing="16"><TextBlock Text="编辑书签" Style="{StaticResource SubtitleTextBlockStyle}"/><TextBox x:Name="BookmarkTitle" Header="标题" AutomationProperties.Name="书签标题"/><TextBox x:Name="BookmarkUrl" Header="网址" AutomationProperties.Name="书签网址"/><TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SaveButton" Content="保存书签" Style="{StaticResource AccentButtonStyle}"/><Button x:Name="OpenButton" Content="打开书签"/><Button x:Name="DeleteButton" Content="删除书签"/></StackPanel><TextBlock Text="主窗口的书签按钮可直接打开收藏列表。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></ScrollViewer></Grid></Page>