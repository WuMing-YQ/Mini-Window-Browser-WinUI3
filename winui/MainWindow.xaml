<Window x:Class="MiniWindow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小窗浏览器">
<Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel x:Name="Chrome" Spacing="2">
<Grid x:Name="CaptionRow" Height="32" Background="Transparent">
<Grid.ColumnDefinitions><ColumnDefinition x:Name="CaptionLeftInset" Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="CaptionRightInset" Width="138"/></Grid.ColumnDefinitions>
<Grid x:Name="CaptionDragArea" Grid.Column="1" Background="Transparent" Padding="12,0,8,0" ColumnSpacing="8">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Image Source="ms-appx:///Assets/MiniWindow-titlebar.png" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="小窗浏览器"/>
<TextBlock x:Name="CaptionTitle" Grid.Column="1" Text="小窗浏览器" FontSize="12" VerticalAlignment="Center" TextLineBounds="Tight" TextTrimming="CharacterEllipsis" IsTextScaleFactorEnabled="False"/>
</Grid></Grid>
<Grid Padding="4,2"><TabView x:Name="Tabs" MinWidth="0" TabWidthMode="Equal" CanDragTabs="False" CanReorderTabs="False" IsAddTabButtonVisible="True"/><Button x:Name="TabMenuButton" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinWidth="0" Padding="6,2" Height="30" AutomationProperties.Name="标签菜单"><TextBlock x:Name="ActiveTabTitle" Text="标签" TextTrimming="CharacterEllipsis"/></Button></Grid>
<Grid x:Name="Toolbar" Padding="4,2,4,6" ColumnSpacing="4" RowSpacing="4">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel x:Name="NavigationButtons" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
<Button x:Name="BackButton" Style="{StaticResource ChromeButtonStyle}" Content="&#xE72B;" AutomationProperties.Name="后退" ToolTipService.ToolTip="后退"/>
<Button x:Name="RefreshButton" Style="{StaticResource ChromeButtonStyle}" Content="&#xE72C;" AutomationProperties.Name="刷新或停止" ToolTipService.ToolTip="刷新 / 停止"/>
</StackPanel>
<Border x:Name="AddressField" Grid.Column="1" MinWidth="0" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="Address" MinWidth="0" MinHeight="30" Padding="6,3" FontSize="13" BorderThickness="0" Background="Transparent" AutomationProperties.Name="网址或搜索" KeyDown="AddressKeyDown"/>
<Button x:Name="StarButton" Grid.Column="1" Margin="1" Content="&#xE734;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="收藏当前网页" ToolTipService.ToolTip="收藏 / 取消收藏"/>
</Grid></Border>
<StackPanel x:Name="ActionButtons" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
<Button x:Name="BookmarksButton" Content="&#xE8A4;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="书签" ToolTipService.ToolTip="书签"/>
<Button x:Name="PresetsButton" Content="&#xE74E;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="场景预设" ToolTipService.ToolTip="场景预设"/>
<Button Content="&#xE7B3;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="切换沉浸模式" ToolTipService.ToolTip="进入 / 退出沉浸" Click="ImmersionClick"/>
<Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"/>
</StackPanel>
</Grid></StackPanel>
<StackPanel Grid.Row="1" x:Name="ErrorPanel" Visibility="Collapsed" Spacing="6" Padding="8"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="重试" Click="RetryClick"/><Button x:Name="ErrorSettingsButton" Content="打开设置"/></StackPanel></StackPanel>
<Grid Grid.Row="2" x:Name="WebSlot" Background="White" SizeChanged="WebSlotSizeChanged"/>
</Grid></Window>