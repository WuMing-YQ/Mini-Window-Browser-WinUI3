<Window x:Class="MiniWindow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小窗浏览器">
<Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel x:Name="Chrome" Spacing="2"><Grid ColumnSpacing="2" Padding="4,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TabView x:Name="Tabs" MinWidth="0" TabWidthMode="Equal" CanDragTabs="False" CanReorderTabs="False" IsAddTabButtonVisible="True"/><Button x:Name="TabMenuButton" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinWidth="0" Padding="6,2" Height="30" AutomationProperties.Name="标签菜单"><TextBlock x:Name="ActiveTabTitle" Text="标签" TextTrimming="CharacterEllipsis"/></Button><Button Grid.Column="1" Style="{StaticResource ChromeButtonStyle}" Content="&#xE922;" AutomationProperties.Name="最大化或还原" Click="MaximizeClick"/><Button Grid.Column="2" Style="{StaticResource ChromeButtonStyle}" Content="&#xE76C;" AutomationProperties.Name="隐藏窗口" Click="HideClick"/></Grid>
<Grid Padding="4,2,4,6" ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Button x:Name="BackButton" Style="{StaticResource ChromeButtonStyle}" Content="&#xE72B;" AutomationProperties.Name="后退"/>
<Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource ChromeButtonStyle}" Content="&#xE72C;" AutomationProperties.Name="刷新或停止"/>
<TextBox x:Name="Address" Grid.Column="2" MinWidth="0" MinHeight="28" Padding="6,3" FontSize="13" AutomationProperties.Name="网址或搜索" KeyDown="AddressKeyDown"/>
<Button Grid.Column="3" Content="&#xE72A;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="前往" Click="NavigateClick"/>
<Button x:Name="StarButton" Grid.Column="4" Content="&#xE734;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="收藏当前网页"/>
<Button x:Name="BookmarksButton" Grid.Column="5" Content="&#xE8A4;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="书签"/>
<Button x:Name="PresetsButton" Grid.Column="6" Content="&#xE74E;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="场景预设"/>
<Button Grid.Column="7" Content="&#xE7B3;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="切换沉浸模式" Click="ImmersionClick"/>
<Button x:Name="SettingsButton" Grid.Column="8" Content="&#xE713;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="设置"/>
<Button x:Name="MoreButton" Grid.Column="9" Content="&#xE712;" Style="{StaticResource ChromeButtonStyle}" AutomationProperties.Name="更多"/>
</Grid></StackPanel>
<StackPanel Grid.Row="1" x:Name="ErrorPanel" Visibility="Collapsed" Spacing="6" Padding="8"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="重试" Click="RetryClick"/><Button x:Name="ErrorSettingsButton" Content="打开设置"/></StackPanel></StackPanel>
<Grid Grid.Row="2" x:Name="WebSlot" Background="White" SizeChanged="WebSlotSizeChanged"/>
<TextBlock Grid.Row="3" x:Name="StatusText" FontSize="12" Padding="8,1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
</Grid></Window>